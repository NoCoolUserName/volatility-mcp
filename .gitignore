# This directory predated Git and contains private local state.
# Track only the public project surface; inspect the index before every publish.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md
!/pyproject.toml
!/requirements.txt
!/requirements.lock.txt
!/requirements-dev.txt
!/server.py
!/src/
!/tests/
!/scripts/
!/docs/
!/prompts/
!/reporting/
!/examples/
!/.github/

**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
config.local.*
*.raw
*.mem
*.vmem
*.dmp
*.lime
*.dd
*.zip
*.exe
*.dll
*.sys
*.log
.DS_Store
